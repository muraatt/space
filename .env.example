# Frontend build (Vercel): public WebSocket authority, without trailing slash.
VITE_GAME_SERVER_URL=wss://orbital-authority.example.com

# Long-lived authority process (Render/Fly/Railway or a VM).
HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGINS=https://orbital.example.vercel.app
IDENTITY_STORE_PATH=/data/identities.json
