# Frontend build (Vercel): public WebSocket authority, without trailing slash.
VITE_GAME_SERVER_URL=wss://orbital-authority.example.com

# Long-lived authority process (Render/Fly/Railway or a VM).
HOST=0.0.0.0
PORT=8787
ALLOWED_ORIGINS=https://orbital.example.vercel.app
# Set only behind a trusted proxy such as Render; enables per-client registration limits.
TRUST_PROXY=1
# Production persistence. Keep the real connection string in the host environment.
DATABASE_URL=postgresql://user:password@host:5432/database
# Local development fallback when DATABASE_URL is unset.
IDENTITY_STORE_PATH=/data/identities.json
